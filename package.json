{
  "name": "svg-opti-detector",
  "version": "1.0.0",
  "type": "module",
  "description": "A powerful tool to analyze, optimize, and detect duplicate inline SVGs in HTML from URLs or local files. Provides detailed optimization reports with color-coded output and potential file size savings.",
  "main": "src/index.ts",
  "bin": {
    "svg-opti-detector": "./src/index.ts"
  },
  "files": [
    "src",
    "readme.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ui": "bun test --bail",
    "bench": "bun test --bench",
    "demo": "bun run src/index.ts test/test-svgs-with-classes.html",
    "demo:duplicates": "bun run src/index.ts test/test-svgs-with-classes.html --duplicates",
    "build": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile svg-opti-detector",
    "build:win": "bun build --compile --minify --sourcemap --bytecode --target=bun-windows-x64 ./src/index.ts --outfile dist/svg-opti-detector-win.exe",
    "build:linux": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-x64 ./src/index.ts --outfile dist/svg-opti-detector-linux",
    "build:macos": "bun build --compile --minify --sourcemap --bytecode --target=bun-darwin-arm64 ./src/index.ts --outfile dist/svg-opti-detector-macos",
    "build:macos-intel": "bun build --compile --minify --sourcemap --bytecode --target=bun-darwin-x64 ./src/index.ts --outfile dist/svg-opti-detector-macos-intel",
    "build:all": "bun run build:win && bun run build:linux && bun run build:macos && bun run build:macos-intel",
    "prepublishOnly": "bun test",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish"
  },
  "keywords": [
    "svg",
    "optimization",
    "html",
    "analysis",
    "duplicate-detection",
    "web-performance",
    "file-size",
    "svgo",
    "cli-tool",
    "optimization-report"
  ],
  "author": {
    "name": "Bob Haring",
    "email": "bob.haring@hotmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobharing/svg-opti-detector.git"
  },
  "bugs": {
    "url": "https://github.com/bobharing/svg-opti-detector/issues"
  },
  "homepage": "https://github.com/bobharing/svg-opti-detector#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "svgo": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "preferGlobal": true
}
